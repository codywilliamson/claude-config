{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/shockbirds/.claude/hooks/pre-commit-validate.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run production:*)",
      "Bash(npm run production:js-footer:*)",
      "Bash(where:*)",
      "Bash(claude mcp add:*)",
      "Bash(claude mcp remove:*)",
      "mcp__trello__list_boards",
      "mcp__trello__list_workspaces",
      "mcp__trello__list_boards_in_workspace",
      "mcp__trello__get_active_board_info",
      "mcp__trello__set_active_board",
      "mcp__trello__get_lists",
      "mcp__trello__get_cards_by_list_id",
      "mcp__trello__get_card",
      "mcp__trello__get_card_comments"
    ],
    "defaultMode": "acceptEdits"
  },
  "model": "opus",
  "includeCoAuthoredBy": false
}