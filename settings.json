{
  "includeCoAuthoredBy": false,
  "model": "opus",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash __CLAUDE_HOME__/hooks/prompt-refine.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash __CLAUDE_HOME__/hooks/pre-commit-validate.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash __CLAUDE_HOME__/hooks/file-size-watchdog.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash __CLAUDE_HOME__/hooks/session-changelog.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash __CLAUDE_HOME__/statusline-command.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "security-guidance@claude-code-plugins": true,
    "feature-dev@claude-code-plugins": true,
    "github@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "agent-sdk-dev@claude-plugins-official": true
  },
  "effortLevel": "high",
  "permissions": {
    "allow": [
      "mcp__trello__list_boards",
      "mcp__trello__list_workspaces",
      "mcp__trello__list_boards_in_workspace",
      "mcp__trello__get_active_board_info",
      "mcp__trello__set_active_board",
      "mcp__trello__get_lists",
      "mcp__trello__get_cards_by_list_id",
      "mcp__trello__get_card",
      "mcp__trello__get_card_comments"
    ],
    "defaultMode": "acceptEdits"
  },
  "skipDangerousModePermissionPrompt": true
}
