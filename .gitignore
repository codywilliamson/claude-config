# Ignore everything by default
*

# But track these important configuration files
!.gitignore
!.gitattributes
!README.md
!CLAUDE.md
!settings.json
!keybindings.json
!statusline-command.sh

# Track custom agents, commands, hooks, and skills
!agents/
!agents/*.md
!commands/
!commands/*.md
!hooks/
!hooks/**
!skills/
!skills/**

# Track sync scripts and documentation
!scripts/
!scripts/**
!docs/
!docs/**

# Never commit credentials or sensitive data
.credentials.json
.env.local

# Machine-local settings overlay — generated per machine, never shared.
# sync.mjs merges this over the repo's settings.json to produce the live file.
settings.local.json

# Ignore runtime/cache directories.
# Leading slash matters: an unanchored `debug/` also matches `skills/debug/`,
# which silently kept that skill out of the repo for months.
/cache/
/debug/
/downloads/
/file-history/
/history.jsonl
/ide/
/plans/
/projects/
/shell-snapshots/
/stats-cache.json
/statsig/
/telemetry/
/todos/
!.github/
!.github/**
