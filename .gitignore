# Ignore everything by default
*

# But track these important configuration files
!.gitignore
!README.md
!CLAUDE.md
!settings.json
!keybindings.json
!statusline-command.sh

# Track custom agents, commands, hooks, and skills
!agents/
!agents/*.md
!commands/
!commands/*.md
!hooks/
!hooks/**
!skills/
!skills/**

# Track sync scripts
!scripts/
!scripts/**

# Never commit credentials or sensitive data
.credentials.json

# Ignore runtime/cache directories
cache/
debug/
downloads/
file-history/
history.jsonl
ide/
plans/
projects/
shell-snapshots/
stats-cache.json
statsig/
telemetry/
todos/
